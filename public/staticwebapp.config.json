{
  "$schema": "https://json.schemastore.org/staticwebapp.config.json",
  "responseOverrides": {
    "404": {
      "rewrite": "/404.html",
      "statusCode": 404
    }
  },
  "globalHeaders": {
    "Content-Security-Policy": "default-src 'self'; base-uri 'self'; connect-src 'self' https://api.sociobot.in; form-action 'self' https://api.sociobot.in; frame-ancestors 'none'; img-src 'self' blob:; manifest-src 'self'; media-src 'self' blob:; object-src 'none'; script-src 'self'; style-src 'self'; worker-src 'self'",
    "Permissions-Policy": "microphone=(self)",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Strict-Transport-Security": "max-age=31536000; includeSubDomains; preload",
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY"
  },
  "routes": [
    {
      "route": "/log/practice",
      "rewrite": "/log/index.html"
    },
    {
      "route": "/log/practice/",
      "rewrite": "/log/index.html"
    },
    {
      "route": "/log/pairs",
      "rewrite": "/log/index.html"
    },
    {
      "route": "/log/pairs/",
      "rewrite": "/log/index.html"
    },
    {
      "route": "/log/data",
      "rewrite": "/log/index.html"
    },
    {
      "route": "/log/data/",
      "rewrite": "/log/index.html"
    },
    {
      "route": "/demo/practice",
      "rewrite": "/demo/index.html"
    },
    {
      "route": "/demo/practice/",
      "rewrite": "/demo/index.html"
    },
    {
      "route": "/demo/pairs",
      "rewrite": "/demo/index.html"
    },
    {
      "route": "/demo/pairs/",
      "rewrite": "/demo/index.html"
    },
    {
      "route": "/demo/data",
      "rewrite": "/demo/index.html"
    },
    {
      "route": "/demo/data/",
      "rewrite": "/demo/index.html"
    },
    {
      "route": "/assets/*",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "route": "/icons/*",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "route": "/sw.js",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate"
      }
    },
    {
      "route": "/index.html",
      "headers": {
        "Cache-Control": "no-cache, must-revalidate"
      }
    }
  ]
}
